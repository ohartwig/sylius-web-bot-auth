{
    "name": "koh/sylius-web-bot-auth",
    "description": "Web Bot Auth key directory for Sylius: publishes an Ed25519 JWKS at /.well-known/http-message-signatures-directory.",
    "type": "sylius-bundle",
    "license": "MIT",
    "keywords": [
        "sylius",
        "web-bot-auth",
        "http-message-signatures",
        "jwks",
        "ed25519",
        "agent"
    ],
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu"
        }
    ],
    "homepage": "https://github.com/ohartwig/sylius-web-bot-auth",
    "support": {
        "issues": "https://github.com/ohartwig/sylius-web-bot-auth/issues",
        "source": "https://github.com/ohartwig/sylius-web-bot-auth"
    },
    "require": {
        "php": "^8.5.11",
        "ext-sodium": "*",
        "koh/sylius-agent-contracts": "^1.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0"
    },
    "require-dev": {
        "koh/dev-sylius": "^1.0",
        "phpstan/phpstan": "^2.3.0",
        "phpunit/phpunit": "^11.5.57"
    },
    "autoload": {
        "psr-4": {
            "Koh\\SyliusWebBotAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\SyliusWebBotAuth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/packages.json",
            "only": [
                "koh/*"
            ]
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
